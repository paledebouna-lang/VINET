// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  action  String
  actorId String?
  target  String?
  ip      String?

  @@index([actorId, at])
  @@map("audit_log")
}

model User {
  id                  String         @id
  name                String
  email               String
  emailVerified       Boolean        @default(false)
  image               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  role                String         @default("particulier")
  // Every account gets a number at sign-up; the matricule is built from it (see matriculeOf).
  memberNumber        Int            @unique @default(autoincrement())
  // Set by an admin: a suspended account cannot sign in and its listings go offline.
  suspendedAt         DateTime?
  tickets             Ticket[]
  vehicles            Vehicle[]
  sightings           Sighting[]
  theftCases          TheftCase[]
  caseEvents          CaseEvent[]
  sessions            Session[]
  accounts            Account[]
  listings            Listing[]
  conversations       Conversation[]
  messages            Message[]
  sellerProfile       SellerProfile?
  bookings            Booking[]
  favorites           Favorite[]
  reports             Report[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum ListingStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Category {
  VOITURE
  MOTO
  UTILITAIRE
}

model Listing {
  id                String         @id @default(cuid())
  sellerId          String
  seller            User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status            ListingStatus  @default(PENDING)
  category          Category
  brand             String
  model             String
  year              Int
  mileageKm         Int
  fuel              String
  transmission      String
  priceFcfa         Int
  // The price before the seller's last edit, kept until that edit is published and watchers are told.
  previousPriceFcfa Int?
  kind              ListingKind    @default(SALE)
  // Rental offers only. For a rental, priceFcfa is the price per day.
  depositFcfa       Int?
  kmPerDay          Int?
  zone              String?
  // A rental vehicle must carry a GPS fitted by its owner; the serial is never public.
  gpsModel          String?
  gpsSerial         String?
  // The AVS passport of the vehicle on offer, when its seller has one.
  vehicleId         String?
  vehicle           Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  documents         Document[]
  bookings          Booking[]
  commune           String
  description       String
  // Never shown in full to the public: see maskVin.
  vin               String?
  rejectionReason   String?
  createdAt         DateTime       @default(now())
  publishedAt       DateTime?
  photos            ListingPhoto[]
  conversations     Conversation[]
  favorites         Favorite[]
  reports           Report[]

  @@index([status, publishedAt])
  @@index([sellerId])
  @@map("listing")
}

// The files live in UPLOAD_DIR as <id>.webp and <id>-s.webp.
model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position  Int

  @@index([listingId, position])
  @@map("listing_photo")
}

// The seller's public identity. No phone number or e-mail is ever part of it.
model SellerProfile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  // A seller with a company is a professional and gets an "E" matricule; without one, a "P".
  company         String?
  position        String?
  yearsExperience Int?
  // Set by an admin; cleared whenever the seller edits the profile.
  verifiedAt      DateTime?

  @@map("seller_profile")
}

// All buyer-seller exchanges happen here; contact details are never revealed to the other party.
model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  // A side has unread messages when its read time is older than lastMessageAt.
  buyerReadAt   DateTime?
  sellerReadAt  DateTime?
  messages      Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("message")
}

model Favorite {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  // The price when saved: a lower price later is the user's price alert.
  priceAtSave Int

  @@id([userId, listingId])
  @@map("favorite")
}

model Report {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([listingId, reporterId])
  @@map("report")
}

enum ListingKind {
  SALE
  RENT
}

enum BookingStatus {
  REQUESTED
  DECLINED
  ACCEPTED
  SIGNED
  ACTIVE
  CLOSED
  CANCELLED
}

model Booking {
  id                String        @id @default(cuid())
  listingId         String
  listing           Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renterId          String
  renter            User          @relation(fields: [renterId], references: [id], onDelete: Cascade)
  status            BookingStatus @default(REQUESTED)
  // Both days are part of the rental: 10 to 12 is three days.
  startDate         DateTime      @db.Date
  endDate           DateTime      @db.Date
  days              Int
  // Copied from the listing at request time, so a later edit cannot change an agreed price.
  pricePerDayFcfa   Int
  totalFcfa         Int
  depositFcfa       Int
  renterFullName    String
  licenceNumber     String
  // Frozen when the owner accepts; the hash proves what each side signed.
  contractText      String?
  contractHash      String?
  ownerSignedAt     DateTime?
  renterSignedAt    DateTime?
  // The renter's separate consent to GPS tracking for the duration of the rental.
  trackingConsentAt DateTime?
  createdAt         DateTime      @default(now())
  closedAt          DateTime?
  documents         Document[]
  inspections       Inspection[]
  tickets           Ticket[]

  @@index([listingId, status])
  @@index([renterId])
  @@map("booking")
}

enum InspectionPhase {
  DEPARTURE
  RETURN
}

// AVS Rental Check: recorded by the owner, confirmed by the renter.
model Inspection {
  id          String          @id @default(cuid())
  bookingId   String
  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  phase       InspectionPhase
  mileageKm   Int
  fuelPercent Int
  notes       String?
  // Departure: deposit received. Return: deposit handed back.
  depositDone Boolean
  createdAt   DateTime        @default(now())
  confirmedAt DateTime?
  documents   Document[]

  @@unique([bookingId, phase])
  @@map("inspection")
}

enum DocumentKind {
  INSURANCE
  LICENCE
  INSPECTION
  REGISTRATION
  THEFT
}

// Private images, never served publicly: see /documents/[id]. Files live in UPLOAD_DIR like photos.
model Document {
  id           String       @id
  kind         DocumentKind
  listingId    String?
  listing      Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookingId    String?
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inspectionId String?
  inspection   Inspection?  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  theftCaseId  String?
  theftCase    TheftCase?   @relation(fields: [theftCaseId], references: [id], onDelete: Cascade)
  position     Int          @default(0)

  @@index([listingId])
  @@index([bookingId])
  @@index([inspectionId])
  @@index([vehicleId])
  @@index([theftCaseId])
  @@map("document")
}

// A request to the MonAuto team. With a booking it is a dispute about that rental,
// and both parties of the rental see the team's answer.
model Ticket {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime  @default(now())
  answer     String?
  answeredAt DateTime?

  @@index([answeredAt])
  @@index([userId])
  @@map("ticket")
}

// AVS Vehicle Passport: the digital identity of a vehicle. It does not replace
// the registration papers, a title of ownership or an insurance certificate.
model Vehicle {
  id           String      @id @default(cuid())
  // Printed in the QR code. Random, so that a valid one cannot be guessed.
  avsId        String      @unique
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category     Category
  brand        String
  model        String
  year         Int
  color        String
  // VIN or frame number. Unique: a second passport for the same vehicle is a fraud signal.
  serial       String      @unique
  plate        String?
  // Set by an admin after checking the registration papers.
  verifiedAt   DateTime?
  createdAt    DateTime    @default(now())
  listings     Listing[]
  // Authorised zone: a circle. Leaving it raises an alert.
  zoneLat      Float?
  zoneLng      Float?
  zoneRadiusKm Float?
  tracker      Tracker?
  alerts       Alert[]
  theftCases   TheftCase[]
  sightings    Sighting[]
  documents    Document[]

  @@index([ownerId])
  @@map("vehicle")
}

enum SightingKind {
  OBSERVATION
  SUSPECT
}

// What someone reports after scanning a QR code. The position, when given, is the
// reporter's phone at that moment: a report, never a certified position of the vehicle.
model Sighting {
  id         String       @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  kind       SightingKind
  note       String
  latitude   Float?
  longitude  Float?
  accuracyM  Int?
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  @@index([vehicleId, createdAt])
  @@index([reporterId, createdAt])
  @@map("sighting")
}

// A GPS tracker fitted to a vehicle. It reports through POST /api/trackers/positions with its key.
model Tracker {
  id         String     @id @default(cuid())
  vehicleId  String     @unique
  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  model      String
  serial     String     @unique
  // SHA-256 of the device key. The key itself is shown once, at creation, and never stored.
  keyHash    String     @unique
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime?
  // Last time old positions were deleted for this tracker (see retention in the ingestion route).
  purgedAt   DateTime?
  positions  Position[]

  @@map("tracker")
}

// A position computed by a tracker. recordedAt is the device's clock; receivedAt is ours,
// and differs when the device stored positions while out of coverage.
model Position {
  id         String   @id @default(cuid())
  trackerId  String
  tracker    Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  receivedAt DateTime @default(now())
  latitude   Float
  longitude  Float
  accuracyM  Int?
  speedKmh   Int?
  powerCut   Boolean  @default(false)

  // A position sent twice is stored once.
  @@unique([trackerId, recordedAt])
  @@map("position")
}

enum AlertKind {
  ZONE_EXIT
  POWER_CUT
}

model Alert {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind           AlertKind
  latitude       Float
  longitude      Float
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([vehicleId, acknowledgedAt])
  @@map("alert")
}

enum CaseStatus {
  DECLARED
  ACTIVE
  CLOSED
  REJECTED
}

enum CaseOutcome {
  RECOVERED
  NOT_RECOVERED
  FALSE_DECLARATION
}

// A theft declared by a vehicle's owner. It changes nothing in public until a member of the
// team has confirmed it (status ACTIVE): that human step is what stops malicious declarations.
// The declarant and the author of an entry cannot be deleted while the case exists.
model TheftCase {
  id              String       @id @default(cuid())
  // Shown as VOL-000012 in exchanges with the owner and the authorities.
  number          Int          @unique @default(autoincrement())
  vehicleId       String
  vehicle         Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  declarantId     String
  declarant       User         @relation(fields: [declarantId], references: [id])
  status          CaseStatus   @default(DECLARED)
  stolenAt        DateTime
  place           String
  circumstances   String
  policeReference String?
  // Filing time: also when the declarant accepted the undertakings shown on the form.
  createdAt       DateTime     @default(now())
  decidedAt       DateTime?
  decidedById     String?
  rejectionReason String?
  closedAt        DateTime?
  outcome         CaseOutcome?
  closingNote     String?
  events          CaseEvent[]
  documents       Document[]

  @@index([status])
  @@index([vehicleId])
  @@map("theft_case")
}

enum CaseEventKind {
  NOTE
  OWNER_NOTE
  OWNER_FOUND
  EXPORT
}

// What people add to a case: the team's working notes, the owner's further information,
// and each transmission of the file to an authority (the text is then the recipient).
model CaseEvent {
  id          String        @id @default(cuid())
  theftCaseId String
  theftCase   TheftCase     @relation(fields: [theftCaseId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  kind        CaseEventKind
  text        String
  createdAt   DateTime      @default(now())

  @@index([theftCaseId, createdAt])
  @@map("case_event")
}
